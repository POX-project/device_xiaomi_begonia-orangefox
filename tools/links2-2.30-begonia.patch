+static int fb_evdev_test_bit(const unsigned long *bits, int code)
+{
+	return (bits[code / (8 * sizeof(unsigned long))] >>
+		(code % (8 * sizeof(unsigned long)))) & 1;
+}
+
+static int fb_evdev_has(int fd, int type, int code)
+{
+	unsigned long bits[16];
+	memset(bits, 0, sizeof(bits));
+	if (ioctl(fd, EVIOCGBIT(type, sizeof(bits)), bits) < 0) return 0;
+	if (code < 0 || code >= (int)(sizeof(bits) * 8)) return 0;
+	return fb_evdev_test_bit(bits, code);
+}
+
+static int fb_evdev_scale(int v, int min, int max, int size)
+{
+	long long r;
+	if (max <= min) return 0;
+	r = (long long)(v - min) * (size - 1) / (max - min);
+	if (r < 0) r = 0;
+	if (r >= size) r = size - 1;
+	return (int)r;
+}
+
+static void fb_evdev_mouse(int x, int y, int b)
+{
+	int rs;
+	if (x < 0) x = 0;
+	if (y < 0) y = 0;
+	if (x >= fb_xsize) x = fb_xsize - 1;
+	if (y >= fb_ysize) y = fb_ysize - 1;
+	mouse_x = x;
+	mouse_y = y;
+	last_mouse_buttons = b;
+	if (current_virtual_device && current_virtual_device->mouse_handler)
+		current_virtual_device->mouse_handler(current_virtual_device, x, y, b);
+	redraw_mouse();
+	EINTRLOOP(rs, fsync(fb_handle));
+}
+
+static void fb_evdev_touch_report(struct fb_evdev *d)
+{
+	int x, y, dx, dy;
+	if (!d->have_x || !d->have_y) return;
+	x = fb_evdev_scale(d->raw_x, d->xmin, d->xmax, fb_xsize);
+	y = fb_evdev_scale(d->raw_y, d->ymin, d->ymax, fb_ysize);
+	if (!d->touching) return;
+
+	if (!d->down_sent) {
+		d->down_sent = 1;
+		d->start_x = d->last_x = x;
+		d->start_y = d->last_y = y;
+		d->moved = 0;
+		d->scroll_acc = 0;
+		fb_evdev_mouse(x, y, B_MOVE);
+		return;
+	}
+
+	dx = x - d->last_x;
+	dy = y - d->last_y;
+	d->last_x = x;
+	d->last_y = y;
+	if (abs(x - d->start_x) > 24 || abs(y - d->start_y) > 24)
+		d->moved = 1;
+
+	if (!d->moved) {
+		fb_evdev_mouse(x, y, B_MOVE);
+		return;
+	}
+
+	/* A vertical swipe is a scroll gesture, not a text selection. */
+	d->scroll_acc += dy;
+	if (d->scroll_acc >= 24) {
+		d->scroll_acc = 0;
+		fb_evdev_mouse(x, y, B_MOVE | B_WHEELUP);
+	} else if (d->scroll_acc <= -24) {
+		d->scroll_acc = 0;
+		fb_evdev_mouse(x, y, B_MOVE | B_WHEELDOWN);
+	} else {
+		fb_evdev_mouse(x, y, B_MOVE);
+	}
+	(void)dx;
+}
+
+static void fb_evdev_in(void *arg)
+{
+	struct fb_evdev *d = (struct fb_evdev *)arg;
+	struct input_event ev[32];
+	int n, i, rs;
+
+	EINTRLOOP(n, (int)read(d->fd, ev, sizeof(ev)));
+	if (n <= 0) return;
+	n /= (int)sizeof(ev[0]);
+	for (i = 0; i < n; i++) {
+		if (ev[i].type == EV_ABS) {
+			if (ev[i].code == d->abs_x) { d->raw_x = ev[i].value; d->have_x = 1; }
+			else if (ev[i].code == d->abs_y) { d->raw_y = ev[i].value; d->have_y = 1; }
+			else if (ev[i].code == ABS_MT_TRACKING_ID) {
+				/* Some MT drivers do not emit BTN_TOUCH. */
+				if (ev[i].value >= 0) {
+					d->touching = 1;
+					d->down_sent = 0;
+					d->moved = 0;
+				} else if (d->touching) {
+					d->touching = 0;
+					if (!d->moved && d->down_sent) {
+						fb_evdev_mouse(d->start_x, d->start_y, B_LEFT | B_DOWN);
+						fb_evdev_mouse(d->start_x, d->start_y, B_LEFT | B_UP);
+					}
+					d->down_sent = 0;
+					d->scroll_acc = 0;
+				}
+			}
+		} else if (ev[i].type == EV_KEY) {
+			if (d->is_touch && (ev[i].code == BTN_TOUCH ||
+			    ev[i].code == BTN_LEFT || ev[i].code == BTN_MOUSE)) {
+				if (ev[i].value) {
+					d->touching = 1;
+					d->down_sent = 0;
+					d->moved = 0;
+				} else if (d->touching) {
+					d->touching = 0;
+					if (!d->moved && d->down_sent) {
+						fb_evdev_mouse(d->start_x, d->start_y, B_LEFT | B_DOWN);
+						fb_evdev_mouse(d->start_x, d->start_y, B_LEFT | B_UP);
+					}
+					d->down_sent = 0;
+					d->scroll_acc = 0;
+				}
+			}
+		} else if (ev[i].type == EV_SYN && ev[i].code == SYN_REPORT) {
+			if (d->is_touch) fb_evdev_touch_report(d);
+		}
+	}
+	EINTRLOOP(rs, fsync(fb_handle));
+}
+
+static void fb_evdev_key_in(void *arg)
+{
+	struct fb_evdev *d = (struct fb_evdev *)arg;
+	struct input_event ev[32];
+	int n, i;
+
+	EINTRLOOP(n, (int)read(d->fd, ev, sizeof(ev)));
+	if (n <= 0) return;
+	n /= (int)sizeof(ev[0]);
+	for (i = 0; i < n; i++) {
+		if (ev[i].type != EV_KEY || ev[i].value != 1) continue;
+		switch (ev[i].code) {
+		case KEY_VOLUMEUP:
+			svgalib_queue_key(fb_kbd, KBD_PAGE_UP, 0);
+			break;
+		case KEY_VOLUMEDOWN:
+			svgalib_queue_key(fb_kbd, KBD_PAGE_DOWN, 0);
+			break;
+		case KEY_POWER:
+		case KEY_BACK:
+			/* No on-screen keyboard here: quit and let the wrapper
+			 * resume the recovery GUI. */
+			svgalib_queue_key(fb_kbd, 'q', 0);
+			break;
+		case KEY_UP:
+			svgalib_queue_key(fb_kbd, KBD_UP, 0);
+			break;
+		case KEY_DOWN:
+			svgalib_queue_key(fb_kbd, KBD_DOWN, 0);
+			break;
+		case KEY_LEFT:
+			svgalib_queue_key(fb_kbd, KBD_LEFT, 0);
+			break;
+		case KEY_RIGHT:
+			svgalib_queue_key(fb_kbd, KBD_RIGHT, 0);
+			break;
+		case KEY_ENTER:
+			svgalib_queue_key(fb_kbd, KBD_ENTER, 0);
+			break;
+		}
+	}
+}
+
+static void unhandle_fb_evdev(void)
+{
+	int i;
+	if (fb_touch.fd >= 0) {
+		set_handlers(fb_touch.fd, NULL, NULL, NULL);
+		close(fb_touch.fd);
+		fb_touch.fd = -1;
+	}
+	for (i = 0; i < fb_nkeys; i++) {
+		if (fb_keys[i].fd >= 0) {
+			set_handlers(fb_keys[i].fd, NULL, NULL, NULL);
+			close(fb_keys[i].fd);
+			fb_keys[i].fd = -1;
+		}
+	}
+	fb_nkeys = 0;
+	fb_hev_touch = -1;
+}
+
+static void handle_fb_evdev(void)
+{
+	DIR *dir;
+	struct dirent *de;
+	int fd, i;
+
+	fb_hev_touch = -1;
+	fb_nkeys = 0;
+	dir = opendir("/dev/input");
+	if (!dir) return;
+	while ((de = readdir(dir)) != NULL) {
+		char path[64];
+		struct input_absinfo ai;
+		int is_touch, has_keys;
+		if (strncmp(de->d_name, "event", 5)) continue;
+		snprintf(path, sizeof(path), "/dev/input/%s", de->d_name);
+		fd = open(path, O_RDONLY | O_NONBLOCK);
+		if (fd < 0) continue;
+
+		is_touch = 0;
+		if (fb_evdev_has(fd, EV_ABS, ABS_MT_POSITION_X) &&
+		    fb_evdev_has(fd, EV_ABS, ABS_MT_POSITION_Y))
+			is_touch = 2;
+		else if (fb_evdev_has(fd, EV_ABS, ABS_X) &&
+			 fb_evdev_has(fd, EV_ABS, ABS_Y))
+			is_touch = 1;
+
+		if (is_touch && fb_hev_touch < 0) {
+			/* Keep the stopped recovery GUI from replaying our touches. */
+			ioctl(fd, EVIOCGRAB, 1);
+			memset(&fb_touch, 0, sizeof(fb_touch));
+			fb_touch.fd = fd;
+			fb_touch.is_touch = 1;
+			fb_touch.abs_x = (is_touch == 2) ? ABS_MT_POSITION_X : ABS_X;
+			fb_touch.abs_y = (is_touch == 2) ? ABS_MT_POSITION_Y : ABS_Y;
+			if (ioctl(fd, EVIOCGABS(fb_touch.abs_x), &ai) == 0) {
+				fb_touch.xmin = ai.minimum;
+				fb_touch.xmax = ai.maximum;
+			}
+			if (ioctl(fd, EVIOCGABS(fb_touch.abs_y), &ai) == 0) {
+				fb_touch.ymin = ai.minimum;
+				fb_touch.ymax = ai.maximum;
+			}
+			set_handlers(fd, fb_evdev_in, NULL, &fb_touch);
+			fb_hev_touch = fd;
+			continue;
+		}
+
+		has_keys = fb_evdev_has(fd, EV_KEY, KEY_VOLUMEUP) ||
+			   fb_evdev_has(fd, EV_KEY, KEY_VOLUMEDOWN) ||
+			   fb_evdev_has(fd, EV_KEY, KEY_POWER);
+		if (has_keys && fb_nkeys < (int)(sizeof(fb_keys) / sizeof(fb_keys[0]))) {
+			ioctl(fd, EVIOCGRAB, 1);
+			memset(&fb_keys[fb_nkeys], 0, sizeof(fb_keys[0]));
+			fb_keys[fb_nkeys].fd = fd;
+			set_handlers(fd, fb_evdev_key_in, NULL, &fb_keys[fb_nkeys]);
+			fb_nkeys++;
+			continue;
+		}
+		close(fd);
+	}
+	closedir(dir);
+	(void)i;
+}
