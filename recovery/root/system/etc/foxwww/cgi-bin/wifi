#!/system/bin/sh
. /system/etc/foxwww/cgi-bin/lib.sh

require_post
require_token
read_body

action=$(body_param action)
case "$action" in
    on|start)       cmd=on ;;
    off|stop)       cmd=off ;;
    restart)        cmd=restart ;;
    *)              json_error "400 Bad Request" "unknown action" ;;
esac

out=$("$FOXWIFI" "$cmd" 2>&1)
rc=$?
message=$(printf '%s\n' "$out" | tail -n 1)

if [ "$rc" -ne 0 ]; then
    json_error "500 Internal Server Error" "${message:-WiFi action failed}"
fi

json_header
printf '{"ok":true,"message":"%s"}\n' "$(json_escape "$message")"
