# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.

# "unified" branch: this single fstab serves BOTH partition layouts.
#   * dynamic  -> system/vendor/product/system_ext/odm live inside `super`, so
#                 the `logical` entries below are used. TWRP discards any
#                 `logical` entry it cannot prepare (Prepare_Super_Volume
#                 failure), which is what makes these a no-op on devices with
#                 no super partition.
#   * physical -> the by-name entries below are the only ones left in that case.
# Read-only system/vendor partitions are listed as explicit erofs + ext4
# pairs. TWRP probes the real filesystem with libblkid and uses the matching
# entry's mount flags, so a ROM can ship either layout. The second entry for
# each mount point is folded into the first by TWRP's fstab parser.
# /data keeps an explicit ext4 + f2fs pair either way.

#<src>                                           <mnt_point>           <type>   <mnt_flags and options>                                         <fs_mgr_flags>

# --- dynamic layout: logical partitions inside super ---
system                                          /system               erofs    ro                                                              wait,logical,avb=vbmeta,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system                                          /system               ext4     ro                                                              wait,logical,avb=vbmeta,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext                                      /system_ext           erofs    ro                                                              wait,logical,first_stage_mount
system_ext                                      /system_ext           ext4     ro                                                              wait,logical,first_stage_mount
product                                         /product              erofs    ro                                                              wait,logical,first_stage_mount
product                                         /product              ext4     ro                                                              wait,logical,first_stage_mount
vendor                                          /vendor               erofs    ro                                                              wait,logical,avb=vbmeta,first_stage_mount
vendor                                          /vendor               ext4     ro                                                              wait,logical,avb=vbmeta,first_stage_mount
odm                                             /odm                  erofs    ro                                                              wait,logical,first_stage_mount
odm                                             /odm                  ext4     ro                                                              wait,logical,first_stage_mount

# --- non-dynamic layout: physical by-name partitions ---
/dev/block/platform/bootdevice/by-name/system    /system               erofs    ro                                                              wait,avb=vbmeta,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
/dev/block/platform/bootdevice/by-name/system    /system               ext4     ro                                                              wait,avb=vbmeta,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
/dev/block/platform/bootdevice/by-name/vendor    /vendor               erofs    ro                                                              wait,avb,first_stage_mount
/dev/block/platform/bootdevice/by-name/vendor    /vendor               ext4     ro                                                              wait,avb,first_stage_mount

# --- common to both layouts ---
/dev/block/platform/bootdevice/by-name/misc      /misc                 emmc     defaults                                                        defaults
# FALLBACK ONLY.  TWRP normally parses the installed ROM's vendor fstab
# (/vendor/etc/fstab.<hardware>) and uses its /data and /metadata entries,
# so each ROM's exact crypto layout wins automatically: FBE v1 for the
# stock/legacy begonia ROMs, FBE v2 for modern ROMs, plus metadata and
# wrapped-key flags where the ROM uses them.
#
# These lines are used only when the vendor fstab cannot be found.  Default
# to the modern FBE v2 layout, including metadata, because that is what new
# Android releases use.  vold is patched to inspect the real policy on
# /data/misc and fall back to v1, removing wrapped-key/IV_INO_LBLK_32, when
# the installed data is legacy v1.
/dev/block/platform/bootdevice/by-name/userdata   /data       ext4     noatime,nosuid,nodev,noauto_da_alloc,errors=panic,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,fileencryption=aes-256-xts:aes-256-cts:v2+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0
/dev/block/platform/bootdevice/by-name/userdata   /data       f2fs     noatime,nosuid,nodev,discard,flush_merge,reserve_root=134217,resgid=1065,alloc_mode=reuse,fsync_mode=nobarrier,inlinecrypt wait,check,formattable,quota,latemount,reservedsize=128m,fileencryption=aes-256-xts:aes-256-cts:v2+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0
/dev/block/platform/bootdevice/by-name/metadata  /metadata             ext4     noatime,nosuid,nodev,discard                                    wait,check,formattable,first_stage_mount
