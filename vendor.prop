# Crypto
# Match the stock begonia vendor.prop: the ROM uses FBE policy v1 and has no
# metadata-encrypted userdata.  Do not add dm-default-key or ::v2 here; those
# properties came from the incorrect "Enable FBEv2" change and make vold
# advertise a crypto layout this device does not use.
ro.crypto.volume.filenames_mode=aes-256-cts
